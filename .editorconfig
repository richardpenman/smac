# Editor settings matching the existing sources (docs/CLEANUP_PLAN.md, "Formatting").
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,py}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{sh,cmake,yml}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{tsv,steps}]
indent_style = tab
